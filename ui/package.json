{
  "name": "@ductus/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Ductus web UI. Built into the engine binary; uses only the public REST API.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && node scripts/budget.mjs",
    "api-types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check": "tsc -p . && eslint . && prettier --check . && vitest run",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "//overrides": "openapi-typescript declares typescript ^5 but only uses it to print code, which 6.0 does the same way. TypeScript stays on 6.0 (as vendored in the engine) until typescript-eslint supports 7.",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
