# Ductus settings, read when the "Ductus" service starts. One NAME=value per line.
# After editing:   Restart-Service Ductus     (first time: Start-Service Ductus)
# Logs: C:\ProgramData\Ductus\logs\ductus.<date>.log
#
# This file holds secrets (the database password): only administrators, SYSTEM and the service
# can read it. Keep it that way.

# The engine's Postgres database (it creates its tables on first start). Required.
# verify-full checks the server's certificate (sslrootcert= for a CA this server doesn't trust
# already); without sslmode it's libpq's prefer: TLS if offered, the certificate not checked.
# DUCTUS_DATABASE_URL=postgres://ductus:PASSWORD@dbhost/ductus?sslmode=verify-full

# The project (interfaces/, ductus.yaml, environments/): a Git clone, usually.
DUCTUS_PROJECT=C:\ProgramData\Ductus\project

# Which environment's variables and secrets to use (environments/<env>.yaml, secrets/<env>.json).
DUCTUS_ENV=prod

# Opens secrets/<env>.json (make one with `ductus secret init`).
# DUCTUS_SECRET_KEY=

# Where the REST API and web UI listen (default 127.0.0.1:7700; api.listen in ductus.yaml, which
# this overrides). Before opening it to other machines, give it a certificate (api.tls in
# ductus.yaml) and an allow list (api.allow): the browser's sign-in only works over HTTPS.
# DUCTUS_API_LISTEN=127.0.0.1:7700

# How long a stop may take to finish the messages in hand (default 30s).
# DUCTUS_STOP_TIMEOUT=30s
