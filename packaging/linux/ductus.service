[Unit]
Description=Ductus integration engine
Documentation=https://getductus.com
# Postgres may be on this server or elsewhere: wait for the network either way. A database that
# isn't up yet makes the engine fail its start, and systemd tries again (Restart below).
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
# The engine says when every interface is up (`systemctl start` waits for it) and when it stops.
Type=notify
NotifyAccess=main
# A start migrates the database first, which can take long after an upgrade: no limit, as before.
TimeoutStartSec=infinity
# systemd keeps the engine's listening sockets while it restarts or after a crash, and hands them
# to the next start: senders' connections wait for it instead of being refused. One per port.
FileDescriptorStoreMax=4096
User=ductus
Group=ductus
# DUCTUS_DATABASE_URL, DUCTUS_ENV, DUCTUS_SECRET_KEY, DUCTUS_PROJECT ...: see the file.
EnvironmentFile=/etc/ductus/ductus.env
WorkingDirectory=/var/lib/ductus
ExecStart=/usr/bin/ductus run
# `systemctl reload ductus` hands the engine over to the binary now on disk (an upgrade) and the
# project as it is now (a deploy), with ductus.env read again: the new engine starts beside the
# running one on the same listening sockets, and nothing is refused. One that can't start leaves
# the running one as it was (the reload fails, and `journalctl -u ductus` says why). It asks over
# /run/ductus/control (the engine's user only). No time limit here: `--timeout` (5 min) is it.
ExecReload=/usr/bin/ductus handover --with-environment
RuntimeDirectory=ductus
RuntimeDirectoryMode=0700
# The engine stops cleanly on SIGTERM: no new messages, the ones in hand finished and saved,
# within DUCTUS_STOP_TIMEOUT (30 s). Give it longer than that before systemd kills it.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45
Restart=on-failure
# After a crash senders wait this long plus the start (their connections queue; none refused).
RestartSec=5
# A drained engine asked to stop (`ductus drain --stop`) exits 0: it stays stopped.
SuccessExitStatus=0
# A refused start exits 3: another engine runs these interfaces on the database, or a lane change
# would strand waiting messages. Trying again every 5 s changes neither; a person has to act
# (`journalctl -u ductus` says what), then `systemctl start ductus`.
RestartPreventExitStatus=3
# Many connections: one per sender and receiver, and the database pool.
LimitNOFILE=65536

# Hardening: the engine needs the network and its own folder, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ductus
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# Listening below port 1024 (an MLLP port of 104, say) needs this instead of root:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
