# Ductus engine settings, read by the ductus service (systemd EnvironmentFile: KEY=value, no
# quotes needed). Readable by root and the ductus group only: it holds the database password and
# the secrets key. Upgrades never overwrite this file. After a change: systemctl restart ductus

# The database (the engine creates its tables on first start; the user must own the database).
#   sudo -u postgres createuser --pwprompt ductus
#   sudo -u postgres createdb --owner ductus ductus
# On another machine (Azure and AWS managed Postgres require TLS), have its certificate checked:
#   postgres://ductus:PASSWORD@db1.hospital.org/ductus?sslmode=verify-full&sslrootcert=/etc/ductus/tls/db-ca.pem
# (sslrootcert only for a CA this server doesn't trust already). Without sslmode it is libpq's
# prefer: TLS when the server offers it, its certificate not checked; the start log says which.
DUCTUS_DATABASE_URL=postgres://ductus:CHANGE-ME@localhost/ductus

# The project: interfaces/, ductus.yaml, environments/ (usually a Git clone).
DUCTUS_PROJECT=/var/lib/ductus/project

# Or release mode: run the release deployed here (`ductus deploy`), unpacked from the database into
# this folder, instead of a project folder. Comment out DUCTUS_PROJECT above to use it. Several
# projects deployed to this environment on one database: name this engine's with
# DUCTUS_RELEASE_PROJECT. A deploy reuses a passing check of the same release from the last hour
# (nothing deployed since); 0 runs the gate at every deploy.
#DUCTUS_RELEASES=/var/lib/ductus/releases
#DUCTUS_RELEASE_PROJECT=
#DUCTUS_DEPLOY_REUSE_CHECK=1h
# What this environment takes (release mode): only releases deployed to these environments first
# (their record travels in the release: `ductus deploy ID --from <test> --to <here>`), and only
# releases made on these branches (a trailing * matches the start). A rollback isn't held to them;
# --force doesn't skip them. Labels in the release, unsigned: the real lock is who has `deploy`.
#DUCTUS_DEPLOY_REQUIRES=test
#DUCTUS_DEPLOY_BRANCHES=main

# Which environment's variables and secrets to use (environments/<env>.yaml, secrets/<env>.json).
DUCTUS_ENV=prod

# The key that opens secrets/<env>.json (`ductus secret init` makes one).
#DUCTUS_SECRET_KEY=

# The REST API and web UI: this machine only by default (api.listen in ductus.yaml; this wins).
# Before opening it to the network, give it a certificate (api.tls in ductus.yaml) and an allow
# list (api.allow): the browser's session cookie is only sent over HTTPS.
#DUCTUS_API_LISTEN=127.0.0.1:7700

# Threads for interface code (default: one per CPU core) and the database pool.
#DUCTUS_THREADS=
#DUCTUS_DB_CONNECTIONS=32

# How long a stop may take to finish the messages in hand (keep it under TimeoutStopSec, 45 s).
#DUCTUS_STOP_TIMEOUT=30s

# Logging (to the journal: journalctl -u ductus): info by default; e.g. info,ductus_runtime=debug
#RUST_LOG=info
